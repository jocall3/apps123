# .env - Environment variables for the Meta-Application

# --- General Application Settings ---
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=info # Options: debug, info, warn, error

# Secret key for application security (e.g., session management, JWTs)
# IMPORTANT: Generate a strong, random key for production.
APP_SECRET=your_strong_random_app_secret_here

# --- Database Configuration ---
# Example using SQLite for local development. For production, consider PostgreSQL, MySQL, etc.
# DATABASE_URL="postgresql://user:password@host:port/database_name"
DATABASE_URL=sqlite:///./app.db

# --- AI / LLM Configuration ---
# API Key for OpenAI services (e.g., GPT models)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ORGANIZATION_ID=your_openai_organization_id_here (optional)
# OPENAI_BASE_URL=https://api.openai.com/v1 (optional, for custom endpoints)

# API Key for Anthropic services (e.g., Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API Key for Google Cloud AI services (e.g., Gemini models)
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Default LLM model to use for code generation and analysis
DEFAULT_LLM_MODEL=gpt-4o # e.g., gpt-4o, claude-3-opus-20240229, gemini-pro
# Maximum number of tokens for LLM generated responses
MAX_LLM_TOKENS=4000

# --- Version Control / Deployment Integration ---
# GitHub Personal Access Token for interacting with GitHub repositories
# Required for creating new repos, pushing code, etc.
# GITHUB_TOKEN=your_github_personal_access_token_here
# GITHUB_USERNAME=your_github_username_here (optional, for some operations)

# AWS Credentials (uncomment and fill if deploying to AWS or using AWS services)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_REGION=us-east-1

# AZURE Credentials (uncomment and fill if deploying to Azure or using Azure services)
# AZURE_CLIENT_ID=your_azure_client_id_here
# AZURE_CLIENT_SECRET=your_azure_client_secret_here
# AZURE_TENANT_ID=your_azure_tenant_id_here
# AZURE_SUBSCRIPTION_ID=your_azure_subscription_id_here

# GCP Credentials (if using GCP services, usually handled via service account key file path)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp_service_account_key.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id